      "css": ".ds-button-primary{font-family:var(--font,Manrope,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:48px;padding:8px 12px;border:1px solid transparent;border-radius:4px;background:var(--accent,#b7c5a3);color:var(--accent-ink,#1b2616);font-size:16px;line-height:24px;font-weight:600;text-decoration:none;transition:background-color 240ms var(--ease,cubic-bezier(.32,.72,0,1)),color 240ms var(--ease,cubic-bezier(.32,.72,0,1)),transform 240ms var(--ease,cubic-bezier(.32,.72,0,1))}.ds-button-primary svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex:none}@media(hover:hover) and (pointer:fine){.ds-button-primary:hover{background:var(--accent-hover,#cfdbc1)}}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#b7c5a3);outline-offset:4px;border-radius:4px}.ds-button-primary:active{transform:translateY(1px);transition-duration:120ms}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
