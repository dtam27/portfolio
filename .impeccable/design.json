      "html": "<ul class=\"ds-experience\"><li><span class=\"ds-experience-role\">Recruitment ambassador</span><span class=\"ds-experience-company\">College of Computer, Mathematical, and Natural Sciences<br>University of Maryland</span><span class=\"ds-experience-period\">September 2026 to present</span></li></ul>",
