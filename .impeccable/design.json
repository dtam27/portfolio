  "narrative": {
    "northStar": "Daniel Tam Portfolio",
    "overview": "The portfolio retains black and dark neutral surfaces, warm light text, and a muted sage accent. Manrope carries every text role. Large headings, compact metadata, and readable descriptions let visitors scan Daniel's work and qualifications without decorative copy.\n\nMajor sections are spacious; project details are more compact. Real screenshots provide visual evidence, while thin borders, modest corners, and tonal surfaces organize the page. Headings use direct labels such as “Daniel Tam,” “About me,” “Technical skills,” and “Contact.” Keep the static HTML, CSS, and JavaScript system straightforward to maintain on GitHub Pages.",
    "keyCharacteristics": [
      "Dark neutral surfaces with a single muted sage accent.",
      "Real project screenshots as the primary visual evidence.",
      "Large, tightly tracked headings paired with readable, compact detail.",
      "Flat, bordered panels and modest corner radii.",
      "Native disclosures, visible keyboard focus, and optional motion."
    ],
    "rules": [
      {
        "name": "Accent use",
        "body": "Use sage for intentional emphasis and interaction; let the neutral surfaces carry the composition.",
        "section": "colors"
      },
      {
        "name": "Typeface",
        "body": "Use the local Manrope family throughout; establish hierarchy through size, weight, spacing, and contrast.",
        "section": "typography"
      },
      {
        "name": "Surface depth",
        "body": "Separate regions with the established neutral surfaces and borders; keep their resting appearance flat.",
        "section": "elevation"
      },
      {
        "name": "Optional motion",
        "body": "Content is visible at rest. Reduced motion disables transitions and smooth scrolling; interaction states remain legible without animation. The shared easing is `cubic-bezier(.32,.72,0,1)`.",
        "section": "components"
      },
      {
        "name": "Portrait fidelity",
        "body": "About uses a 176 × 220 pixel head-and-shoulders presentation of Daniel’s supplied portrait. A precise alpha mask removes the wall, preserving original visible RGB pixels. The image sits beside prose on wide screens and above it below 1100px, without a border, shadow, or circular frame.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the dark neutral and sage identity when extending the site.",
      "Do use the local Manrope family and the established text hierarchy.",
      "Do use direct headings and full qualification, organization, and date wording.",
      "Do use real project screenshots with meaningful alternative text and captions.",
      "Do keep full phone captures intact in the iOS gallery.",
      "Do retain visible keyboard focus, native disclosures, and visible navigation without JavaScript.",
      "Do keep content readable when motion is reduced and at widths of 320px and above."
    ],
    "donts": [
      "Don't replace factual screenshots with invented product interfaces.",
      "Don't communicate important information only through hover or animation.",
      "Don't give noninteractive technology tags button or filter behavior.",
      "Don't add competing accent colors, ornamental shadows, or blurred surfaces to this established visual system.",
      "Don't crop the full iOS app limit capture in the project gallery."
    ]
  }
}
